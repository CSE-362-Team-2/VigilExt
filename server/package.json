    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "~4.17.21",
    "@types/node": "~20.12.12",
    "@types/pg": "~8.11.0",
    "tsx": "~4.7.2",
    "typescript": "~5.6.2"
  }
}
