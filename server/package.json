{
  "name": "server",
  "version": "0.1.0",
  "description": "VigilNext Risk-Aware Payment Gateway API - Week 1 skeleton",
  "packageManager": "pnpm@11.28.5",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
